{
  "name": "peerchat",
  "version": "0.1.0",
  "description": "A high-level, event-driven wrapper around PeerJS for video calls and data channels",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "peerjs",
    "webrtc",
    "peer-to-peer",
    "video-call",
    "data-channel",
    "p2p",
    "real-time"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suraj-jha/peerchat"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.0",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "peerjs": "^1.5.5"
  }
}
